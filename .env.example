# Copia este archivo como .env y cambia los valores. El archivo .env NUNCA se sube a GitHub.
DB_NAME=cevicheria
DB_USER=cevicheria
DB_PASSWORD=cambia-esta-contrasena
DB_URL=jdbc:postgresql://localhost:5432/cevicheria

# Secreto para firmar los JWT (HS256): minimo 32 bytes. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-32-bytes-o-mas

# Primer ADMIN: solo se usa al arrancar si todavia no existe ningun ADMIN. PIN de 4 digitos.
ADMIN_USERNAME=mama
ADMIN_PIN=0000
